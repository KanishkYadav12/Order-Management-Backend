# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV="development"          # development | test | production
PORT=5000
LOG_LEVEL="debug"               # fatal | error | warn | info | debug | trace

# ─── Database ───────────────────────────────────────────────────────────────
# Transactions require a replica set. Atlas provides one by default; a local
# standalone mongod does not.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/"
DATABASE_NAME="HotelOrderManagementSystem"

# ─── Auth secrets ───────────────────────────────────────────────────────────
# Each must be at least 32 characters and must differ from the others.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_SECRET=""
REFRESH_TOKEN_EXPIRES="30d"
# Signs the short-lived per-table session handed to QR customers.
CUSTOMER_SESSION_SECRET=""
CUSTOMER_SESSION_EXPIRES="4h"

# ─── URLs ───────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"              # owner dashboard: reset links
CUSTOMER_APP_URL="http://localhost:3001"          # QR menu: encoded into table QR codes
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# ─── Realtime ───────────────────────────────────────────────────────────────
# Server-side only. Never expose this to the browser — the API mints
# capability-scoped tokens for clients via /api/v1/realtime/token.
ABLY_API_KEY=""

# ─── Media ──────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── AI (optional — free providers only) ────────────────────────────────────
# The analytics — menu engineering, demand forecasting, prep planning, dish
# pairings, anomaly detection — are plain statistics over your own sales data.
# They always run and need nothing configured here.
#
# These settings only power the conversational assistant and the written
# briefing. Every option below has a free tier:
#
#   gemini  Google AI Studio — free, no card. Key: https://aistudio.google.com/apikey
#   groq    Groq Cloud — free tier, very fast. Key: https://console.groq.com/keys
#   ollama  A model on your own machine — free and private. https://ollama.com
#   none    Off. Reports are returned as data instead of prose.
AI_PROVIDER="none"
AI_API_KEY=""
# Optional: override the provider's default model.
#   gemini → gemini-2.0-flash   groq → llama-3.3-70b-versatile   ollama → llama3.1
AI_MODEL=""
# Only used when AI_PROVIDER=ollama.
OLLAMA_URL="http://localhost:11434"
